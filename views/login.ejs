<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Login | GeoAgri Conserva</title>

  <!-- ✅ Redirect if already logged in -->
  <script>
    if (localStorage.getItem("token")) {
      window.location.replace("/");
    }
  </script>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Source Sans Pro', 'Helvetica Neue', Arial, sans-serif;
      background: #f3f4f6;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .card {
      background-image: url('/images/login_background.jpg');
      background-size: cover;
      background-position: center;
      padding: 40px;
      border-radius: 8px;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.2);
      position: relative;
    }

    .card::before {
      content: "";
      position: absolute;
      inset: 0;
      background: rgba(255,255,255,0.92);
      border-radius: 8px;
    }

    .card > * {
      position: relative;
      z-index: 1;
    }

    .header {
      text-align: center;
      margin-bottom: 30px;
    }

    .logo img {
      width: 110px;
      margin-bottom: 15px;
    }

    h2 {
      font-size: 26px;
      color: #065f46;
      margin-bottom: 6px;
    }

    .subtitle {
      font-size: 14px;
      color: #374151;
    }

    .error {
      display: none;
      background: #fee2e2;
      color: #991b1b;
      padding: 12px;
      border-radius: 6px;
      margin-bottom: 16px;
      text-align: center;
      font-size: 14px;
    }

    .input-group {
      margin-bottom: 16px;
    }

    label {
      font-size: 12px;
      font-weight: 700;
      color: #374151;
      margin-bottom: 6px;
      display: block;
    }

    input {
      width: 100%;
      padding: 12px;
      border-radius: 4px;
      border: 2px solid #e5e7eb;
      font-size: 15px;
    }

    input:focus {
      outline: none;
      border-color: #10b981;
    }

    button {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, #10b981, #059669);
      color: white;
      border: none;
      border-radius: 4px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      margin-top: 8px;
    }

    button:disabled {
      opacity: 0.7;
      cursor: not-allowed;
    }

    .divider {
      margin: 20px 0;
      text-align: center;
      font-size: 14px;
      color: #6b7280;
    }

    .google-btn {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      padding: 12px;
      border: 2px solid #e5e7eb;
      border-radius: 6px;
      text-decoration: none;
      color: #374151;
      font-weight: 600;
    }

    .google-btn:hover {
      background: #f9fafb;
    }

    .link {
      margin-top: 16px;
      text-align: center;
      font-size: 14px;
    }

    .link a {
      color: #059669;
      font-weight: 600;
      text-decoration: none;
    }
  </style>
</head>

<body>

<div class="card">
  <div class="header">
    <div class="logo">
      <img src="/images/icar-emblem.png"
           onerror="this.src='https://icar.org.in/sites/default/files/icar_logo_0.png'">
    </div>
    <h2>GeoAgri Conserva</h2>
    <p class="subtitle">Location-Driven Soil & Water Conservation DSS</p>
  </div>

  <div class="error" id="errorBox"></div>

  <form id="loginForm">
    <div class="input-group">
      <label>Username</label>
      <input id="username" required />
    </div>

    <div class="input-group">
      <label>Password</label>
      <input id="password" type="password" required />
    </div>

    <button id="loginBtn">Sign In</button>

    <div class="divider">OR</div>

    <a class="google-btn"
       href="https://swc-ai-engine-clean-production.up.railway.app/oauth2/authorization/google">
      <img src="https://developers.google.com/identity/images/g-logo.png" width="20">
      Continue with Google
    </a>
  </form>

  <div class="link">
    Don’t have an account?
    <a href="/register">Create one →</a>
  </div>
</div>

<script>
  const form = document.getElementById("loginForm");
  const btn = document.getElementById("loginBtn");
  const errorBox = document.getElementById("errorBox");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    btn.disabled = true;
    errorBox.style.display = "none";

    const username = username.value;
    const password = password.value;

    try {
      const res = await fetch(
        "https://swc-ai-engine-clean-production.up.railway.app/auth/login",
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ username, password })
        }
      );

      if (!res.ok) throw new Error("Invalid credentials");

      const { token } = await res.json();
      localStorage.setItem("token", token);

      window.location.replace("/");

    } catch (err) {
      errorBox.textContent = err.message;
      errorBox.style.display = "block";
      btn.disabled = false;
    }
  });
</script>

</body>
</html>
